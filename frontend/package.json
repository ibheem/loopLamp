{
  "name": "looplamp-frontend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "clean": "node --input-type=module -e \"import { rmSync } from 'node:fs'; rmSync('.next', { recursive: true, force: true });\"",
    "dev": "next dev",
    "dev:clean": "npm run clean && next dev",
    "build": "next build",
    "start": "next start",
    "test": "node --test tests/dashboard.test.mjs"
  },
  "dependencies": {
    "next": "^15.5.22",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  }
}
